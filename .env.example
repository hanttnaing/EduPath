# =========================================================
# EduPath Backend Environment Variables
# =========================================================

# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DATABASE=edupath_db

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60

# CORS
# Local development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production example:
# CORS_ORIGINS=https://your-edupath-project.vercel.app
